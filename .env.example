# Optional: point to the downloaded official 100K dataset
DATASET_PATH=data/raw/5G_netops_data_100K.csv
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_SENTENCE_TRANSFORMERS=true
VECTOR_DB_PATH=storage/chroma
MODEL_PATH=models
STORAGE_PATH=storage
# No top-k limit is used by the Streamlit application.
SEMANTIC_WEIGHT=0.65
LEXICAL_WEIGHT=0.35
SEMANTIC_CANDIDATES=40
LEXICAL_CANDIDATES=40
ALLOW_SAMPLE_FALLBACK=true
# Optional live LLM RAG + LLM-as-judge
# Claude (Anthropic) configuration:
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional OpenAI configuration:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM provider preference: 'auto', 'anthropic', or 'openai'
LLM_PROVIDER=auto

# Run with deterministic offline/demo behavior (no live LLM dependency)
DEMO_MODE=false
LOG_LEVEL=INFO
# Persistent vector/index cache location
VECTOR_DB_PATH=storage/chroma
